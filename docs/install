#!/bin/sh
# Installs the agentbook command from the latest GitHub release.
#   curl -fsSL https://enigmaticzee.github.io/agentbook/install | sh
# Set AGENTBOOK_DIR to choose where it goes (default: /usr/local/bin, or ~/.local/bin if that
# isn't writable).
set -eu

repo="EnigmaticZee/agentbook"
os="$(uname -s | tr '[:upper:]' '[:lower:]')"
arch="$(uname -m)"
case "$arch" in
    x86_64|amd64) arch=amd64 ;;
    arm64|aarch64) arch=arm64 ;;
    *) echo "agentbook: unsupported CPU: $arch" >&2; exit 1 ;;
esac
case "$os" in
    darwin|linux) ;;
    *) echo "agentbook: use the Windows zip from https://github.com/$repo/releases" >&2; exit 1 ;;
esac

dir="${AGENTBOOK_DIR:-/usr/local/bin}"
if [ ! -w "$dir" ]; then dir="$HOME/.local/bin"; mkdir -p "$dir"; fi

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
url="https://github.com/$repo/releases/latest/download/agentbook_${os}_${arch}.tar.gz"
echo "Downloading $url"
curl -fsSL "$url" -o "$tmp/a.tgz"
curl -fsSL "https://github.com/$repo/releases/latest/download/checksums.txt" -o "$tmp/sums" || true
if [ -s "$tmp/sums" ]; then
    want="$(grep "agentbook_${os}_${arch}.tar.gz" "$tmp/sums" | cut -d' ' -f1)"
    if command -v sha256sum >/dev/null; then have="$(sha256sum "$tmp/a.tgz" | cut -d' ' -f1)"
    else have="$(shasum -a 256 "$tmp/a.tgz" | cut -d' ' -f1)"; fi
    [ "$want" = "$have" ] || { echo "agentbook: checksum mismatch, not installing" >&2; exit 1; }
fi
tar -xzf "$tmp/a.tgz" -C "$tmp" agentbook
install -m 0755 "$tmp/agentbook" "$dir/agentbook"
echo "Installed agentbook to $dir/agentbook"
case ":$PATH:" in *":$dir:"*) ;; *) echo "Add $dir to your PATH to run it." ;; esac
"$dir/agentbook" version
